<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotMonitor_2"
        xmlns:ViewModels="clr-namespace:RobotMonitor_2.ViewModels" x:Class="RobotMonitor_2.MainWindow"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        mc:Ignorable="d"
        Title="MainWindow" Height="768" Width="1024" WindowStyle="None">
    <Window.Resources>

        <ViewModels:BoolToSetViewString x:Key="BoolToSetViewString"/>
        <ViewModels:BoolToSettingString x:Key="BoolToSettingString"/>
        <ViewModels:ServerConnectionBoolToColor x:Key="ServerConnectionBoolToColor"/>
        <ViewModels:BoolToReverseBool x:Key="BoolToReverseBool"/>
        <ViewModels:BoolToColorString x:Key="BoolToColorString"/>
        <ViewModels:BooleanToVisibilityConverterRevers x:Key="BooleanToVisibilityConverterRevers"/>
        <ViewModels:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" CornerRadius="0" BorderThickness="5" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="White">
        <Button x:Name="btn_Minimize" HorizontalAlignment="Right" VerticalAlignment="Top" Height="60" Width="65" Margin="0,2,70,0" BorderBrush="{x:Null}" Click="btn_Minimize_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="btnMn" CornerRadius="0" Margin="0" BorderThickness="3" BorderBrush="Gray" >
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/Non_Minimum.png"/>
                        </Border.Background>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" ContentSource="Content" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnMn" Property="BorderBrush" Value="Blue"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button x:Name="btn_Exit" HorizontalAlignment="Right" VerticalAlignment="Top" Height="60" Width="65" Margin="0,2,2,0" BorderBrush="{x:Null}" Click="btn_Exit_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="btnESC" CornerRadius="0" Margin="0" BorderThickness="3" BorderBrush="Gray" >
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/Non_Exit.png"/>
                        </Border.Background>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" ContentSource="Content" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnESC" Property="BorderBrush">
                                <Setter.Value>
                                    <SolidColorBrush Color="Blue"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Rectangle HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"  Height="48" Width="267">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Resources/KodneshiAUK_Small_Alpha.png"/>
            </Rectangle.Fill>
        </Rectangle>
        <Grid Margin="0,10,146,0" VerticalAlignment="Top" Height="48" Width="322" HorizontalAlignment="Right" Background="#FFE6E6E6">
            <TextBlock TextWrapping="Wrap" Text="Mold Robot System #2" VerticalAlignment="Center" FontSize="28" FontWeight="Bold" TextAlignment="Center" Background="#FFE6E6E6"/>
        </Grid>
        <Grid Margin="0,8,480,0" VerticalAlignment="Top" Height="50" Width="262" HorizontalAlignment="Right" Background="#FFE6E6E6">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding WorkMode}" Foreground="{Binding IsWorkModeTextColor}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Background="#FFE6E6E6" />
        </Grid>
        <!-- System Condtion Label -->
        <TextBox TextWrapping="Wrap" Text="NOT CONNECTED TO ROBOT"  Margin="0,65,0,0" VerticalAlignment="Top" Height="70" FontSize="44" FontWeight="Bold" TextAlignment="Center" Foreground="White" Background="#FFAFAFAF" IsReadOnly="True" BorderBrush="{x:Null}"  IsHitTestVisible="False" VerticalContentAlignment="Center"/>
        <TextBox TextWrapping="Wrap" Text="READY" Visibility="{Binding R_IsReady, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,65,0,0" VerticalAlignment="Top" Height="70" FontSize="44" FontWeight="Bold" TextAlignment="Center" Foreground="White" Background="#FF1F56FF" IsReadOnly="True" BorderBrush="{x:Null}" IsHitTestVisible="False" VerticalContentAlignment="Center"/>
        <TextBox TextWrapping="Wrap" Text="STOPPED" Visibility="{Binding R_IsStopped, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,65,0,0" VerticalAlignment="Top" Height="70" FontSize="44" FontWeight="Bold" TextAlignment="Center" Foreground="White" Background="#FFF3441D" IsReadOnly="True" BorderBrush="{x:Null}" IsHitTestVisible="False" VerticalContentAlignment="Center" />
        <TextBox TextWrapping="Wrap" Text="RUNNING" Visibility="{Binding R_IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,65,0,0" VerticalAlignment="Top" Height="70" FontSize="44" FontWeight="Bold" TextAlignment="Center" Foreground="Black" Background="#FF2EFF27" IsReadOnly="True" BorderBrush="{x:Null}" IsHitTestVisible="False" VerticalContentAlignment="Center" />
        <TextBox TextWrapping="Wrap" Text="ORIGIN" Visibility="{Binding R_IsOrigin, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,65,0,0" VerticalAlignment="Top" Height="70" FontSize="44" FontWeight="Bold" TextAlignment="Center" Foreground="Black" Background="#FF1DF3EE" IsReadOnly="True" BorderBrush="{x:Null}" IsHitTestVisible="False" VerticalContentAlignment="Center"/>
        <TextBox TextWrapping="Wrap" Text="NOT CONNECTED TO ROBOT" Visibility="{Binding ServerConnection, Converter={StaticResource BooleanToVisibilityConverterRevers}}" Margin="0,65,0,0" VerticalAlignment="Top" Height="70" FontSize="44" FontWeight="Bold" TextAlignment="Center" Foreground="White" Background="#FFAFAFAF" IsReadOnly="True" BorderBrush="{x:Null}"  IsHitTestVisible="False" VerticalContentAlignment="Center"/>

        <!-- Bottom Buttons -->
        <Grid Margin="5,673,5,5" Background="#FFE6E6E6" VerticalAlignment="Bottom">
            <Button x:Name="btn_Start" Content="START" Margin="150,5,0,5" Height="80" Width="130" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left"  PreviewMouseLeftButtonDown="btn_Start_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btn_Start_MouseLeftButtonUp" IsEnabled="{Binding IsAuto}" >
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btn_STT" CornerRadius="0" Margin="0" BorderThickness="5" Background="{Binding StartButtonColor}" BorderBrush="Green" >
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" ContentSource="Content" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="btn_Reset" Content="RESET" Height="80" Width="130" FontSize="24" FontWeight="Bold" Margin="285,5,0,5" HorizontalAlignment="Left" Click="btn_Reset_Click" IsEnabled="{Binding ResetbtnEnable}" >
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnRS" CornerRadius="0" Margin="0" BorderThickness="5" BorderBrush="#FF828200" >
                            <Border.Background>
                                <SolidColorBrush Color="#FFEBEB00" Opacity="{Binding ResetBtnOpacity}"/>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnRS" Property="Background" Value="#FF646400"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="btn_Stop" Content="STOP" Height="80" Width="130" FontSize="24" FontWeight="Bold" Margin="420,5,0,5" HorizontalAlignment="Left" PreviewMouseLeftButtonUp="btn_Stop_PreviewMouseLeftButtonUp" PreviewMouseLeftButtonDown="btn_Stop_PreviewMouseLeftButtonDown" Background="#FFDDDDDD">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnST" CornerRadius="0" Margin="0" BorderThickness="5" BorderBrush="#FF820000">
                            <Border.Background>
                                <SolidColorBrush Color="#FFEB0000" Opacity="1"/>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnST" Property="Background" Value="#FF640000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="btn_SetView" Content="{Binding IsSetView, Converter={StaticResource BoolToSetViewString}}" Visibility="{Binding IsSetView, Converter={StaticResource BooleanToVisibilityConverterRevers}}" HorizontalAlignment="Right" Margin="5,5,145.2,5" Height="80" Width="130" FontSize="24" FontWeight="Bold" Background="#FFE0E0E0" BorderThickness="5,5,5,5" Click="btn_SetView_Click">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnView" CornerRadius="0" Margin="0" BorderThickness="5" Background="WhiteSmoke" BorderBrush="#FF949494">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnView" Property="Background" Value="#FF646464"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="btn_Setting" Content="{Binding IsSetting, Converter={StaticResource BoolToSettingString}}" HorizontalAlignment="Right" Margin="5,5,5,5" Height="80" Width="130" FontSize="24" FontWeight="Bold" Background="#FFE0E0E0" BorderThickness="5,5,5,5" Click="btn_Setting_Click">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnSet" CornerRadius="0" Margin="0" BorderThickness="5" Background="WhiteSmoke" BorderBrush="#FF949494">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnSet" Property="Background" Value="#FF646464"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="btn_Auto" Content="AUTO" HorizontalAlignment="Left" Margin="5,5,0,5" Height="80" Width="140" FontSize="26" FontWeight="Bold" Visibility="{Binding AutoBtn, Converter={StaticResource BooleanToVisibilityConverter}}" Click="btn_Auto_Click" Foreground="#FFE6E6E6" Background="White">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnSet" CornerRadius="0" Margin="0" BorderThickness="5" Background="#FF1919EB" BorderBrush="#FF000082" >
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnSet" Property="Background" Value="#FF646464"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="btn_Manual" Content="Manual" HorizontalAlignment="Left" Margin="5,5,0,5" Height="80" Width="140" FontSize="24" FontWeight="Bold" Visibility="{Binding ManualBtn, Converter={StaticResource BooleanToVisibilityConverter}}" Click="btn_Manual_Click">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnSet" CornerRadius="0" Margin="0" BorderThickness="5" Background="WhiteSmoke" BorderBrush="#FF949494">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnSet" Property="Background" Value="#FF646464"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        <TabControl Margin="0,135,0,100" BorderBrush="{x:Null}">

            <!-- Setting Page -->
            <TabItem Header="SettingPage" Visibility="{Binding TabVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsSelected="{Binding IsSetting}" Height="20" VerticalAlignment="Bottom">
                <Grid Margin="5,0,5,0" Background="#FFE6E6E6">
                    <TabControl Margin="0" BorderBrush="{x:Null}">

                        <!-- Robot Setting Page -->
                        <TabItem Header="Robot" FontSize="18" IsSelected="{Binding RobotSetting}">
                            <Grid>
                                <Grid Margin="5,5,5,5" Background="#FFE6E6E6">
                                    <Label Content="Robot Setting Variables" Margin="5,5,5,0" Height="45" FontSize="26" Foreground="White" FontWeight="Bold" Padding="20,0,0,0" VerticalAlignment="Top" Background="#FF006DDA" VerticalContentAlignment="Center"/>
                                    <StackPanel Margin="1,55,5,5" Orientation="Horizontal">
                                        <StackPanel Width="323" Margin="5,5,0,5" Background="White">
                                            <Grid Height="55">
                                                <Label Content="Robot 제어" Margin="5,5,5,0" Height="45" FontSize="26" Foreground="Black" FontWeight="Bold" Padding="20,0,0,0" VerticalAlignment="Top" Background="#7FA7E1FF" VerticalContentAlignment="Center"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="백분율 속도 ( % )" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_" Text="{Binding IsRobSpeed_Persent}" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox__PreviewMouseLeftButtonDown"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="최대 속도 ( mm/s )" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_1" Text="{Binding IsRobSpeed_MMS}" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_1_PreviewMouseLeftButtonDown"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="프레스 닫힘신호 지속시간" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="18" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_2" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" Text="{Binding IsPressCloseTime}" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_2_PreviewMouseLeftButtonDown"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="챔버 닫힘신호 지속시간" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="18" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_3" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" Text="{Binding IsChamberCloseTime}" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_3_PreviewMouseLeftButtonDown"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_4" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" Text="{Binding Path=y}" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Button x:Name="btn_ImageColloect" Content="이물 이미지 수집" IsEnabled="{Binding R_IsStopped}" Margin="5,5,5,5" FontSize="22" FontWeight="Bold" Click="btn_ImageColloect_Click"  >
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border x:Name="btn_ImgCol" CornerRadius="0" Margin="0" BorderThickness="2" Background="{Binding ImgCollectColor}" BorderBrush="#FF949494">
                                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" ContentSource="Content" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="btn_ImgCol" Property="Background" Value="#FF646464"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>

                                        </StackPanel>
                                        <StackPanel Width="323" Margin="5,5,0,5" Background="White">
                                            <Grid Height="55">
                                                <Label Content="에어 블로우 설정" Margin="5,5,5,0" Height="45" FontSize="26" Foreground="Black" FontWeight="Bold" Padding="20,0,0,0" VerticalAlignment="Top" Background="#7FA7E1FF" VerticalContentAlignment="Center"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="속도 ( mm/s )" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_BlowSpeed" Text="{Binding IsRobBlowSpeed}" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_BlowSpeed_PreviewMouseLeftButtonDown" />
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="1차 상부 작업 횟수 " HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_Blow1stTop" Text="{Binding IsRobBlow1stTopCount}" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_Blow1stTop_PreviewMouseLeftButtonDown"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="1차 하부 작업 횟수" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_Blow1stBot" Text="{Binding IsRobBlow1stBotCount}" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_Blow1stBot_PreviewMouseLeftButtonDown"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="2차 상부 작업 횟수" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_Blow2ndTop" Text="{Binding IsRobBlow2ndTopCount}" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right"  HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_Blow2ndTop_PreviewMouseLeftButtonDown"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="2차 하부 작업 횟수" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_Blow2ndBot" Text="{Binding IsRobBlow2ndBotCount}" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right"  HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_Blow2ndBot_PreviewMouseLeftButtonDown"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="포트 작업 횟수" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_BlowPort" Text="{Binding IsRobBlowPortCount}" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_BlowPort_PreviewMouseLeftButtonDown"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Width="323" Margin="5,5,0,5" Background="White" Height="223" VerticalAlignment="Top">
                                            <Grid Height="55">
                                                <Label Content="이형제 분사 설정" Margin="5,5,5,0" Height="45" FontSize="26" Foreground="Black" FontWeight="Bold" Padding="20,0,0,0" VerticalAlignment="Top" Background="#7FA7E1FF" VerticalContentAlignment="Center"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="속도 ( mm/s )" HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_SpraySpeed" Text="{Binding IsRobSpraySpeed}" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_SpraySpeed_PreviewMouseLeftButtonDown" />
                                                <Image Height="55" Width="100"/>
                                            </Grid>
                                            <Grid Height="55">
                                                <Label Margin="5,5,0,5" Content="분사 횟수 " HorizontalContentAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Height="45"  FontSize="22" FontWeight="Bold" BorderBrush="{x:Null}" Background="{x:Null}"/>
                                                <TextBox x:Name="tBox_SprayTop" Text="{Binding IsRobSprayTopCount}" Margin="0,5,5,5" CaretBrush="Transparent" TextWrapping="Wrap" VerticalAlignment="Top" Height="45" SelectionOpacity="-1" FontSize="22" TextAlignment="Right" HorizontalAlignment="Right" Width="85" Cursor="Hand" Background="#FFF0F0F0" PreviewMouseLeftButtonDown="tBox_SprayTop_PreviewMouseLeftButtonDown"/>
                                            </Grid>
                                            <Grid Height="55">
