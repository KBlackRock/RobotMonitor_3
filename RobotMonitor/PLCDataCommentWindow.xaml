<Window x:Class="RobotMonitor_3.PLCDataCommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotMonitor_3"
        mc:Ignorable="d"
        Title="PLCDataComment" Width="300" WindowStyle="None" 
        SizeToContent="Height">
    <Grid Background="Gray">
        <StackPanel VerticalAlignment="Center" Margin="2" Background="AliceBlue">
            <TextBlock Text="{Binding DataName}" FontSize="28" 
                   TextAlignment="Center" Margin="5"/>
            <TextBlock Text="{Binding DataComment}" FontSize="20" 
                   TextAlignment="Center" Margin="5"/>
            <Button x:Name="OKButton" 
                Content="확인"
                Width="100" Height="40"  Margin="10" FontSize="22" Click="OKButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
