<Window x:Class="RobotMonitor_3.NumberKeyboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotMonitor_3"
        mc:Ignorable="d"
        Title="NumberKeyboard" Height="310" Width="225" WindowStyle="None" >
    <Grid>
        <TextBox x:Name="tBox_Number" Margin="5,49,5,0" TextWrapping="Wrap" Text="{Binding DisplayNumber}" VerticalAlignment="Top" Height="40" FontSize="28" TextAlignment="Right" IsReadOnly="True" IsHitTestVisible="False"/>
        <Button x:Name="btn_7" Content="7" HorizontalAlignment="Left" Margin="5,92,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_7_Click"/>
        <Button x:Name="btn_8" Content="8" HorizontalAlignment="Left" Margin="60,92,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_8_Click"/>
        <Button x:Name="btn_9" Content="9" HorizontalAlignment="Left" Margin="115,92,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_9_Click"/>
        <Button x:Name="btn_BS" Content="←" HorizontalAlignment="Left" Margin="170,92,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="18" Padding="3,3,3,3" Click="btn_BS_Click" FontFamily="Artifakt Element Heavy"/>
        <Button x:Name="btn_4" Content="4" HorizontalAlignment="Left" Margin="5,146,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_4_Click"/>
        <Button x:Name="btn_5" Content="5" HorizontalAlignment="Left" Margin="60,146,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_5_Click"/>
        <Button x:Name="btn_6" Content="6" HorizontalAlignment="Left" Margin="115,146,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_6_Click"/>
        <Button x:Name="btn_Del" Content="Del" HorizontalAlignment="Left" Margin="170,146,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="18" Padding="3,3,3,3" Click="btn_Del_Click"/>
        <Button x:Name="btn_1" Content="1" HorizontalAlignment="Left" Margin="5,200,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_1_Click"/>
        <Button x:Name="btn_2" Content="2" HorizontalAlignment="Left" Margin="60,200,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_2_Click"/>
        <Button x:Name="btn_3" Content="3" HorizontalAlignment="Left" Margin="115,200,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_3_Click"/>
        <Button x:Name="btn_Reverse" Content="±" HorizontalAlignment="Left" Margin="170,200,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_Reverse_Click"/>
        <Button x:Name="btn_0" Content="0" HorizontalAlignment="Left" Margin="5,255,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_0_Click"/>
        <Button x:Name="btn_Dot" Content="." HorizontalAlignment="Left" Margin="60,255,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="30" Padding="3,3,3,3" Click="btn_Dot_Click"/>
        <Button x:Name="btn_Ok" Content="OK" HorizontalAlignment="Left" Margin="115,255,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="18" Padding="3,3,3,3" Click="btn_Ok_Click"/>
        <Button x:Name="btn_Cancel" Content="Cancel" HorizontalAlignment="Left" Margin="170,255,0,0" VerticalAlignment="Top" Height="50" Width="50" Background="#FFE2E2E2" FontSize="12" Padding="3,3,3,3" Click="btn_Cancel_Click"/>
        <Button x:Name="btn_OldData" Margin="5,5,5,0" Height="40" VerticalAlignment="Top" PreviewMouseLeftButtonDown="btn_OldData_PreviewMouseLeftButtonDown">
            <Button.Background>
                <SolidColorBrush Color="#FFDDDDDD" Opacity="0"/>
            </Button.Background>
        </Button>
        <TextBox x:Name="tBox_NumberOld" Margin="5,5,5,0" TextWrapping="Wrap" Text="{Binding DisplayNumberOld}" VerticalAlignment="Top" Height="40" FontSize="28" TextAlignment="Right" IsReadOnly="True" IsHitTestVisible="False" Background="#FFC3C3C3"/>

    </Grid>
</Window>
