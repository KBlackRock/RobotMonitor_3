<Window x:Class="RobotMonitor_2.TimerMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotMonitor_2"
        mc:Ignorable="d"
        Title="TimerMessageBox" Height="200" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="MessageText" FontSize="28" 
                   TextAlignment="Center" Margin="10"/>
            <Button x:Name="CancelButton" 
                Content="취소"
                Width="100" Height="40"  Margin="10" 
                Click="CancelButton_Click" FontSize="22"/>
        </StackPanel>
    </Grid>
</Window>
