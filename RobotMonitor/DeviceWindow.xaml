<Window x:Class="RobotMonitor_3.DeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotMonitor_3"
        mc:Ignorable="d"
        Title="DeviceWindow" Height="580" Width="550" WindowStyle="None">

    <Window.Resources>
        <Style x:Key="TouchTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#FFE2E2E2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style x:Key="KeyboardButtonBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Background" Value="#FFE2E2E2"/>
            <Setter Property="TextAlignment" Value="Center"/>

            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="LostFocus" Handler="TextBox_LostFocus"/>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid Margin="5,5,5,5" Background="#FFE6E6E6">
            <Label Content="Device Name Set" Margin="5,5,5,5" FontSize="26" Foreground="White" FontWeight="Bold" Padding="20,0,0,0" Background="#FF006DDA" VerticalContentAlignment="Center" VerticalAlignment="Top" Height="45"/>
            <Grid Margin="5,50,5,60" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,50,0,5" Grid.Column="0">
                    <Label Content="Device 1 : " FontSize="20" Height="40" />
                    <Label Content="Device 2 : " FontSize="20" Height="40"/>
                    <Label Content="Device 3 : " FontSize="20" Height="40"/>
                    <Label Content="Device 4 : " FontSize="20" Height="40"/>
                    <Label Content="Device 5 : " FontSize="20" Height="40"/>
                    <Label Content="Device 6 : " FontSize="20" Height="40"/>
                    <Label Content="Device 7 : " FontSize="20" Height="40"/>
                    <Label Content="Device 8 : " FontSize="20" Height="40"/>
                    <Label Content="Device 9 : " FontSize="20" Height="40"/>
                    <Label Content="Device 10 : " FontSize="20" Height="40"/>
                </StackPanel>

                <Grid Margin="0,0,0,410" Grid.Column="1">
                    <Label Content="Device Name" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="1" Margin="0,50,0,5">
                    <TextBox x:Name="tBox_Device1" Style="{StaticResource KeyboardButtonBoxStyle}" Text="{Binding DeviceName1, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="tBox_Device2" Style="{StaticResource KeyboardButtonBoxStyle}" Text="{Binding DeviceName2, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="tBox_Device3" Style="{StaticResource KeyboardButtonBoxStyle}" Text="{Binding DeviceName3, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="tBox_Device4" Style="{StaticResource KeyboardButtonBoxStyle}" Text="{Binding DeviceName4, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="tBox_Device5" Style="{StaticResource KeyboardButtonBoxStyle}" Text="{Binding DeviceName5, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="tBox_Device6" Style="{StaticResource KeyboardButtonBoxStyle}" Text="{Binding DeviceName6, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="tBox_Device7" Style="{StaticResource KeyboardButtonBoxStyle}" Text="{Binding DeviceName7, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="tBox_Device8" Style="{StaticResource KeyboardButtonBoxStyle}" Text="{Binding DeviceName8, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="tBox_Device9" Style="{StaticResource KeyboardButtonBoxStyle}" Text="{Binding DeviceName9, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="tBox_Device10" Style="{StaticResource KeyboardButtonBoxStyle}" Text="{Binding DeviceName10, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Grid Margin="0,0,0,410" Grid.Column="2">
                    <Label Content=" Shot&#x0a;Count" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="2" Margin="5,50,0,5">
                    <TextBox Text="{Binding DeviceSize1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TouchTextBoxStyle}" PreviewMouseLeftButtonDown="SizeBox1_PreviewMouseLeftButtonDown"/>
                    <TextBox Text="{Binding DeviceSize2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TouchTextBoxStyle}" PreviewMouseLeftButtonDown="SizeBox2_PreviewMouseLeftButtonDown"/>
                    <TextBox Text="{Binding DeviceSize3, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TouchTextBoxStyle}" PreviewMouseLeftButtonDown="SizeBox3_PreviewMouseLeftButtonDown"/>
                    <TextBox Text="{Binding DeviceSize4, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TouchTextBoxStyle}" PreviewMouseLeftButtonDown="SizeBox4_PreviewMouseLeftButtonDown"/>
                    <TextBox Text="{Binding DeviceSize5, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TouchTextBoxStyle}" PreviewMouseLeftButtonDown="SizeBox5_PreviewMouseLeftButtonDown"/>
                    <TextBox Text="{Binding DeviceSize6, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TouchTextBoxStyle}" PreviewMouseLeftButtonDown="SizeBox6_PreviewMouseLeftButtonDown"/>
                    <TextBox Text="{Binding DeviceSize7, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TouchTextBoxStyle}" PreviewMouseLeftButtonDown="SizeBox7_PreviewMouseLeftButtonDown"/>
                    <TextBox Text="{Binding DeviceSize8, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TouchTextBoxStyle}" PreviewMouseLeftButtonDown="SizeBox8_PreviewMouseLeftButtonDown"/>
                    <TextBox Text="{Binding DeviceSize9, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TouchTextBoxStyle}" PreviewMouseLeftButtonDown="SizeBox9_PreviewMouseLeftButtonDown"/>
                    <TextBox Text="{Binding DeviceSize10, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TouchTextBoxStyle}" PreviewMouseLeftButtonDown="SizeBox10_PreviewMouseLeftButtonDown"/>
                </StackPanel>
            </Grid>

            <Grid VerticalAlignment="Bottom" Margin="5,5,5,5" Height="50" Background="White">
                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <Button x:Name="btn_Apply" Content="Apply" FontSize="24" Width="110" Margin="5,0,5,0" Click="btn_Apply_Click"/>
                    <Button x:Name="btn_OK" Content="OK" FontSize="24" Width="110" Margin="5,0,5,0" Click="btn_OK_Click"/>
                    <Button x:Name="btn_Cancel" Content="Cancel" Width="110" FontSize="24" Margin="5,0,5,0" Click="btn_Cancel_Click"/>
                </StackPanel>
            </Grid>

        </Grid>


    </Grid>
</Window>
