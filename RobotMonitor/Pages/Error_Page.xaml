<Page x:Class="RobotMonitor_3.Pages.Error_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RobotMonitor_3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="533" d:DesignWidth="1024"
      Title="Error_Page">

    <Grid>
        <!-- Error Page -->
        <Grid Background="#FFE6E6E6">
            <Label Content=" Error Message" Margin="5,5,5,0" Height="45" FontSize="30" Foreground="White" FontWeight="Bold" VerticalAlignment="Top" Background="#FFBB0000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0,0,0,0"/>
            <Grid Margin="5,50,5,5" Background="White">
                <ListBox Margin="5" ItemsSource="{Binding ErrorList}" FontSize="22" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
